# Copy to .env.local (gitignored) and fill in. These are public values by design:
# row-level security on every Supabase table keeps each user's data private.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_...
# Google Cloud → Credentials → OAuth client ID of type "Web application"
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=1234567890-xxxx.apps.googleusercontent.com
