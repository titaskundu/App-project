<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Lets us list launchable apps (for the "pick apps to block" screen) without QUERY_ALL_PACKAGES. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application>
        <!-- The watcher. Only the system can bind to it (BIND_ACCESSIBILITY_SERVICE). -->
        <service
            android:name="expo.modules.appblocker.BlockerService"
            android:exported="true"
            android:label="@string/app_blocker_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/app_blocker_accessibility" />
        </service>
    </application>
</manifest>
