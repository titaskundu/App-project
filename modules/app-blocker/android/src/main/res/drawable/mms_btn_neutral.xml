<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="4dp"><shape><solid android:color="#D6CEC1" /><corners android:radius="28dp" /></shape></item>
            <item android:top="4dp" android:bottom="1dp"><shape><solid android:color="#FFFFFF" /><stroke android:width="2dp" android:color="#E7E1D7" /><corners android:radius="28dp" /></shape></item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:top="4dp"><shape><solid android:color="#D6CEC1" /><corners android:radius="28dp" /></shape></item>
            <item android:bottom="5dp"><shape><solid android:color="#FFFFFF" /><stroke android:width="2dp" android:color="#E7E1D7" /><corners android:radius="28dp" /></shape></item>
        </layer-list>
    </item>
</selector>
